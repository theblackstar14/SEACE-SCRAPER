BASE_URL=https://prod2.seace.gob.pe/seacebus-uiwd-pub/buscadorPublico/buscadorPublico.xhtml
HEADLESS=true
PORT=3000

# Postgres del ERP (VPS). Sin esto el pipeline corre igual y guarda el estado
# en data/state/procesos.json — útil en una laptop, no en producción.
DATABASE_URL=postgres://user:pass@localhost:5432/erp
# Dónde viven los documentos descargados (content-addressed por sha256).
DOCS_DIR=./data/docs

# LLM: al menos una. Sin ninguna, el análisis cae a regex.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
