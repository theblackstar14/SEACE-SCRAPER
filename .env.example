BASE_URL=https://prod2.seace.gob.pe/seacebus-uiwd-pub/buscadorPublico/buscadorPublico.xhtml
HEADLESS=true
PORT=3000

# Postgres del ERP (VPS). Sin esto el pipeline corre igual y guarda el estado
# en data/state/procesos.json — útil en una laptop, no en producción.
DATABASE_URL=postgres://user:pass@localhost:5432/erp
# Dónde viven los documentos descargados (content-addressed por sha256).
DOCS_DIR=./data/docs

# Auth de la API. SIN ESTO TODO /api/* QUEDA ABIERTO (y CORS es *).
# Obligatoria en el VPS. El ERP la manda en el header x-api-key.
API_KEY=
RATE_LIMIT_PER_MIN=60

# Salida por proxy. SEACE geo-bloquea: desde fuera de Perú TODO da 403.
# El proxy tiene que estar EN Perú — uno en el mismo VPS no sirve de nada.
# Lo usan Playwright, el cliente HTTP y las descargas de Alfresco.
PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

# LLM: al menos una. Sin ninguna, el análisis cae a regex.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
